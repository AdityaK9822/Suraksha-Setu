# Suraksha Setu — blockchain anchoring (standalone demo; NOT wired into the API)

# RPC endpoint of the local Hardhat node (npx hardhat node)
RPC_URL=http://127.0.0.1:8545

# Signer private key. For local demo, use Hardhat account #0 (the deployer/admin):
# 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Demo only — never use a key that holds real funds.
PRIVATE_KEY=

# Address printed by `npx hardhat run scripts/deploy.ts --network localhost`
CONTRACT_ADDRESS=
